@model DashboardViewModel
@{
    ViewData["Title"] = "Overview";
    ViewData["Section"] = "Overview";
    var triggered = Model.Candidates.Count(row => row.Plan.Triggered);
}
<div class="page-heading">
    <div><div class="eyebrow">Indian equities · Cash market</div><h1>Market workspace</h1><p class="subheading">Rule-led scanning and research. Prices are conditional on your configured data source.</p></div>
    <span class="source-pill @(Model.IsDemo ? "demo" : "provider")"><i></i>@(Model.IsDemo ? "SYNTHETIC DEMO" : "PROVIDER FEED")</span>
</div>
<div class="metric-grid">
    <article class="metric-card"><span>Universe coverage</span><strong>@Model.Candidates.Count <small>stocks</small></strong><em>Liquid-stock sample</em></article>
    <article class="metric-card"><span>Intraday rule matches</span><strong>@triggered <small>active</small></strong><em>ORB + VWAP · latest bar</em></article>
    <article class="metric-card"><span>Data status</span><strong class="metric-status">@(Model.IsDemo ? "Demo" : "Provider")</strong><em>@Model.FeedStatus</em></article>
    <article class="metric-card"><span>Updated</span><strong class="metric-status">@Model.UpdatedAt.ToString("HH:mm") <small>UTC</small></strong><em>Confirm exchange timestamp</em></article>
</div>
<div class="section-heading"><div><h2>Intraday candidates</h2><p>Opening-range break plus VWAP and EMA confirmation. No win-rate promise.</p></div><a class="text-link" asp-action="Intraday">Open scanner <span>→</span></a></div>
<section class="panel table-panel">
    <div class="table-scroll"><table>
        <thead><tr><th>Instrument</th><th>Last</th><th>Change</th><th>Setup</th><th>Rules</th><th>Daily RSI</th><th>ATR %</th><th></th></tr></thead>
        <tbody>
        @foreach (var row in Model.Candidates)
        {
            <tr>
                <td><strong>@row.Stock.Symbol</strong><small>@row.Stock.Company · @row.Stock.Sector</small></td>
                <td>₹@row.Stock.Price.ToString("N2")</td>
                <td class="@(row.Stock.ChangePercent >= 0 ? "positive" : "negative")">@row.Stock.ChangePercent.ToString("+0.00;-0.00")%</td>
                <td><span class="setup-chip @(row.Plan.Triggered ? "ready" : "")">@(row.Plan.Triggered ? row.Plan.Side : "WAIT")</span></td>
                <td>@row.Plan.RuleChecksPassed / 3</td>
                <td>@row.Rsi.ToString("N1")</td>
                <td>@row.AtrPercent.ToString("N2")%</td>
                <td><a class="row-link" asp-action="Research" asp-route-symbol="@row.Stock.Symbol">Research</a></td>
            </tr>
        }
        </tbody>
    </table></div>
</section>
<div class="two-column section-space">
    <section class="panel compact-panel"><div class="panel-heading"><div><div class="eyebrow">Execution discipline</div><h2>No forced trades</h2></div><span class="panel-symbol">01</span></div><p>Only evaluate a setup after its candle closes. If no trigger appears, remain in cash. A signal is not an instruction to trade.</p><a class="text-link" asp-action="Strategies">Read strategy rules <span>→</span></a></section>
    <section class="panel compact-panel"><div class="panel-heading"><div><div class="eyebrow">Evidence before entry</div><h2>Research the stock</h2></div><span class="panel-symbol">02</span></div><p>Review trend, momentum, volatility, volume, fundamentals and event risk. Missing provider fields remain explicitly unavailable.</p><a class="text-link" asp-action="Swing">Open swing research <span>→</span></a></section>
</div>