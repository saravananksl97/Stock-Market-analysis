@model ResearchViewModel
@{
    ViewData["Title"] = "Deep research";
    ViewData["Section"] = "Deep research";
}
<div class="page-heading"><div><div class="eyebrow">Evidence-led stock brief</div><h1>Deep research</h1><p class="subheading">Technical context, provider fundamentals and conditional trade plans in one view.</p></div><span class="source-pill @(Model.IsDemo ? "demo" : "provider")"><i></i>@(Model.IsDemo ? "SYNTHETIC DEMO" : "PROVIDER FEED")</span></div>
<div class="filter-row"><form method="get" asp-action="Research" class="inline-form"><label for="symbol">Instrument</label><select id="symbol" name="symbol" onchange="this.form.submit()"><option value="">Select stock</option>@foreach (var stock in new[]{Model.Stock}){<option selected value="@stock.Symbol">@stock.Symbol · @stock.Company</option>}<option value="RELIANCE">RELIANCE</option><option value="HDFCBANK">HDFCBANK</option><option value="ICICIBANK">ICICIBANK</option><option value="INFY">INFY</option><option value="TCS">TCS</option><option value="SBIN">SBIN</option><option value="LT">LT</option><option value="AXISBANK">AXISBANK</option></select></form><span class="feed-caption">@Model.Stock.DataSource · @Model.FeedStatus</span></div>
<section class="research-hero"><div><div class="eyebrow">@Model.Stock.Symbol · @Model.Stock.Sector</div><h2>@Model.Stock.Company</h2><p class="subheading">Snapshot timestamp: @Model.Stock.AsOf.ToString("yyyy-MM-dd HH:mm") UTC</p></div><div class="hero-price">₹@Model.Stock.Price.ToString("N2")<small class="@(Model.Stock.ChangePercent >= 0 ? "positive" : "negative")">@Model.Stock.ChangePercent.ToString("+0.00;-0.00")%</small></div></section>
<div class="section-heading"><div><h2>Research evidence</h2><p>Fundamental fields are provider-supplied and may be stale; demo mode does not invent them.</p></div></div>
<div class="finding-grid research-findings-grid">@foreach (var finding in Model.Findings){<article class="finding-card"><div class="finding-label">@finding.Label</div><strong class="finding-value">@finding.Value</strong><p>@finding.Interpretation</p></article>}</div>
<div class="two-column section-space"><div>@await Html.PartialAsync("_TradePlan", Model.IntradayPlan)</div><div>@await Html.PartialAsync("_TradePlan", Model.SwingPlan)</div></div>
<section class="panel compact-panel section-space"><div class="eyebrow">Research limits</div><h2>What this brief cannot establish</h2><p>It does not verify management quality, accounting risks, pledged shares, litigation, order-book depth, live news, or point-in-time sector-relative valuation. Add licensed and timestamped fundamental/news feeds and manually review filings before treating this as deep due diligence.</p></section>